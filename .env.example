# =============================================================================
# suricat-frontend (marketing site) — environment template
# Copy to `.env.local` (or `.env`) and fill in values. Never commit secrets.
#
# Compulsory: none — every variable has a safe unset / code default.
# Optional: override defaults or enable optional features.
# =============================================================================

# =============================================================================
# 1. COMPULSORY VARIABLES
# =============================================================================
# (none — all variables below have fallbacks or safe disabled behaviour)

# =============================================================================
# 2. OPTIONAL VARIABLES
# =============================================================================

# Nest API base URL (suricat-apps apps/api). Must include /api/v1.
# Fallback in lib/api/client.ts: http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Cloudflare Turnstile (marketing forms). Leave disabled or unset site key to skip widget.
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# When true/1/yes, every route redirects to /coming-soon (server-only; toggle at runtime on Azure).
# Unset / false → normal site.
COMING_SOON_ENABLED=false
