# Nest API base URL (suricat-dev apps/api). Must include /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Cloudflare Turnstile (marketing forms). Leave disabled or unset site key to skip widget.
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# When true/1/yes, every route redirects to /coming-soon (server-only; toggle at runtime on Azure).
COMING_SOON_ENABLED=false

